

const BASE_ID = 'app4bWf1l4npkFeop';
  const TABLE_NAME = 'ORDERS'; 
  const PERSONAL_ACCESS_TOKEN = env.airtablePAT;

  async function getMostRecentOrder() {
    // 1. Check if user or user.airtableOrderID is missing or empty
    if (!user || !user.airtableOrderID) {
      return "Can't locate most recent order ID ask customer to provide";
    }

    // 2. Construct the single-record URL using the record ID
    const recordId = user.airtableOrderID;
    const url = `https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(TABLE_NAME)}/${recordId}`;

    try {
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${PERSONAL_ACCESS_TOKEN}`,
          'Content-Type': 'application/json'
        }
      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(`Airtable API Error (${response.status}): ${JSON.stringify(errorData)}`);
      }

      const orderRecord = await response.json();
      console.log('Order record retrieved successfully:', orderRecord);
      
      // 3. Return the full order record JSON object
      return orderRecord;
    } catch (error) {
      console.error('Error fetching order:', error);
      throw error;
    }
  }

  // Execute the function and return the result from action()
  const orderResult = await getMostRecentOrder();
  
  return {
    result: orderResult
  };
