
const BASE_ID = 'app4bWf1l4npkFeop';
const TABLE_NAME = 'ORDERS'; 
const PERSONAL_ACCESS_TOKEN = env.airtablePAT;

async function getOrdersByName() {
  // 1. Validate input.name
  if (!input || !input.name || typeof input.name !== 'string') {
    return {
      success: false,
      message: "no orders found with these names",
      records: []
    };
  }

  const searchName = input.name.trim().toLowerCase();
  const safeSearchName = searchName.replace(/'/g, "\\'");

  // 2. Build formula using ARRAYJOIN for linked Customer records
  const formula = `LOWER(ARRAYJOIN({Customer})) = '${safeSearchName}'`;
  const url = `https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(TABLE_NAME)}?filterByFormula=${encodeURIComponent(formula)}`;

  try {
    const response = await fetch(url, {
      method: 'GET',
      headers: {
        'Authorization': `Bearer ${PERSONAL_ACCESS_TOKEN}`,
        'Content-Type': 'application/json'
      }
    });

    if (!response.ok) {
      const errorData = await response.json();
      throw new Error(`Airtable API Error (${response.status}): ${JSON.stringify(errorData)}`);
    }

    const data = await response.json();

    // 3. Handle empty records vs matched records
    if (!data.records || data.records.length === 0) {
      return {
        success: false,
        message: "no orders found with these names",
        records: []
      };
    }

    return {
      success: true,
      message: `Successfully retrieved ${data.records.length} order(s)`,
      records: data.records
    };

  } catch (err) {
    console.error('Error searching orders by name:', err);
    return {
      success: false,
      message: err.message || "Failed to query Airtable",
      records: []
    };
  }
}

// Set global Botpress output variable to match schema directly
var output = await getOrdersByName();
return output;
