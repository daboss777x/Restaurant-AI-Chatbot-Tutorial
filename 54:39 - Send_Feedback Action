
// SENDING OUT THE ORDER
const BASE_ID = 'app4bWf1l4npkFeop';
const TABLE_NAME = 'REVIEWS & FEEDBACK'; 
const CUSTOMERS_TABLE = 'CUSTOMERS';
const PERSONAL_ACCESS_TOKEN = env.airtablePAT;

async function createOrder() {
  const url = `https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(TABLE_NAME)}`;

  const payload = {
    fields: {
      // Order ID (single line text)
      'Customer': user.airtableCustomerID, 
      
      // Total Order Amount (currency)
      'Order': user.airtableOrderID, 
      
      // Order Details (multiline text)
      'Review Text': input.review, 
      
      // Special Instructions (multiline text)
      'Rating': input.ratingFromTen, 
      
      // Linked Record field 
      'Improvements': input.improvements,
    },
    // Enables linking records by text string ('Enosh Omunu') instead of exact record IDs ('recXXXXX')
    typecast: true 
  };

  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${PERSONAL_ACCESS_TOKEN}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(payload)
    });

    if (!response.ok) {
      const errorData = await response.json();
      throw new Error(`Airtable API Error (${response.status}): ${JSON.stringify(errorData)}`);
    }

    const record = await response.json();
    console.log('Record created successfully! ID:', record.id);

    // --- UPDATE CUSTOMER RECORD (Phone Number & User ID) ---
    // Airtable automatically returns the linked customer's record ID inside record.fields.Customer[0]
    const customerRecordId = record.fields?.Customer?.[0];

    if (customerRecordId) {
      // Save Customer Record ID to user object
      user.airtableCustomerID = customerRecordId;

      const customerUrl = `https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(CUSTOMERS_TABLE)}/${customerRecordId}`;

      const customerResponse = await fetch(customerUrl, {
        method: 'PATCH',
        headers: {
          'Authorization': `Bearer ${PERSONAL_ACCESS_TOKEN}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          fields: {
            'User ID': event.userId // Ensure 'userId' variable is defined in your scope
          }
        })
      });

      if (!customerResponse.ok) {
        const customerErr = await customerResponse.json();
        console.error('Error updating Customer details:', JSON.stringify(customerErr));
      } else {
        console.log('Customer details updated successfully! ID:', customerRecordId);
      }
    }

    return record;
  } catch (err) {
    console.error('Error creating record in Airtable:', err);
  }
}

createOrder();
